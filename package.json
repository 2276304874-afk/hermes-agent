{
  "name": "hermes-agent-ui",
  "version": "1.0.0",
  "description": "赫尔墨斯特工 Web UI - 本地 Hermes Agent 聊天前端",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "test:safety": "python3 test/safety.test.py",
    "test:chat": "node test/chat.gateway.smoke.js",
    "smoke": "bash test/routes.smoke.sh",
    "ui": "node test/ui.smoke.js 4173 \"$(cat $HOME/.hermes/ui_token 2>/dev/null)\"",
    "health": "bash healthcheck.sh",
    "backup": "bash backup.sh",
    "mirror": "node scripts/push-via-api.js main",
    "mirror:dry": "node scripts/push-via-api.js main --dry-run",
    "check": "for f in server.js lib/*.js lib/routes/*.js public/app.js scripts/*.js test/*.js; do node --check \"$f\" || exit 1; done"
  }
}
